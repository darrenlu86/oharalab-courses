# SQLite 檔案位置（相對 backend/ 目錄）
SQLITE_PATH=data/brewgo.db
# JWT 簽章金鑰——正式部署務必換成長隨機字串（openssl rand -hex 32）。
# 沒改成正式值時，程式啟動會在終端機印出警告（見 app/config.py），本機開發可忽略。
SECRET_KEY=dev-secret-change-me
# CORS 允許來源，逗號分隔；前後端分開部署時設成前端網址（例如 https://your-frontend.pages.dev）
# 開發模式用 vite proxy 走同源，不需要用到這個設定；正式合體模式（後端 serve 前端 build）也不需要，
# 只有「前後端分開部署」時才需要把這裡改成前端的完整網址。
CORS_ORIGINS=*
