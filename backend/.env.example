# 資料庫後端：sqlite（預設，本地零設定）或 supabase
DB_BACKEND=sqlite
# SQLite 檔案位置（相對 backend/ 目錄）
SQLITE_PATH=data/meowshop.db
# JWT 簽章金鑰——正式部署務必換成長隨機字串（openssl rand -hex 32）
SECRET_KEY=dev-secret-change-me
# 切到 Supabase 才需要以下兩項（Supabase 專案 Settings → API）
SUPABASE_URL=
SUPABASE_KEY=
# CORS 允許來源，逗號分隔；前後端分開部署時設成前端網址
CORS_ORIGINS=*
