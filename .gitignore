# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/

# --- 虛擬環境 ---
.venv/
venv/

# --- 測試/工具快取 ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- 環境變數（含機密資訊，絕不能進版控） ---
.env

# --- 本機資料庫檔案（seed 後每人本機資料不同，不進版控） ---
**/data/*.db
**/data/*.db-journal
**/data/*.sqlite
**/data/*.sqlite3
!**/data/.gitkeep

# --- Node ---
node_modules/
dist/
*.local

# --- 壓測輸出（報告內容已整理進 docs，原始輸出不進版控） ---
**/loadtest/output/

# --- macOS / 編輯器 ---
.DS_Store
.vscode/
.idea/

# --- log ---
*.log
